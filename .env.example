# Groq AI Settings (Get a key at https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
USE_GROQ_WHISPER=true

# Optional Gemini Settings (Get a key at https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Whisper Local Model (tiny, base, small)
WHISPER_MODEL=base

# Database
DATABASE_URL=sqlite:///./meeting_intelligence.db
